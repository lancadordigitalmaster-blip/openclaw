# =============================================================================
# OpenClaw / Wolf Agency — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# For Vercel: add these in Project Settings > Environment Variables.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenRouter (fallback LLM) ---
OPENROUTER_API_KEY=sk-or-...

# --- CORS ---
# Comma-separated list of allowed origins (default: comercial.wolfpacks.com.br, wolf-comercial.vercel.app, localhost:8765)
# ALLOWED_ORIGINS=https://comercial.wolfpacks.com.br,https://wolf-comercial.vercel.app

# --- Proposal URLs ---
# Base URL for public proposal links (default: https://comercial.wolfpacks.com.br)
PROPOSAL_BASE_URL=https://comercial.wolfpacks.com.br

# --- Wolf API Authentication ---
# Used by parse-proposal and update-proposal endpoints.
# Generate a strong random key: openssl rand -hex 32
WOLF_API_KEY=

# --- Admin Dashboard ---
# Used by /api/admin endpoint. Must be set — no default fallback.
# Generate a strong random key: openssl rand -hex 32
ADMIN_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
NETTO_TELEGRAM_ID=789352357

# --- Meta Ads ---
META_ADS_ACCESS_TOKEN=
META_ADS_TOKEN_FORLAN=
META_ADS_TOKEN_TICOMIA=
META_ADS_TOKEN_GR=

# --- ClickUp ---
CLICKUP_API_TOKEN=

# --- Groq (Whisper transcription) ---
GROQ_API_KEY=

# --- Figma ---
FIGMA_TOKEN=

# --- Vercel ---
VERCEL_TOKEN=
